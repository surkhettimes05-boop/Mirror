generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum EntrySource { TEXT VOICE IMPORT SYSTEM }
enum CommitmentStatus { OPEN COMPLETED ABANDONED SUPERSEDED }
enum PredictionStatus { OPEN RESOLVED CANCELLED }
enum EvidenceKind { FACT USER_REPORT INFERENCE EXTERNAL }
enum PatternStatus { PROPOSED ACTIVE REJECTED SUPERSEDED }
enum EvidencePolarity { SUPPORTS COUNTERS }
model User { id String @id @default(cuid()) email String? @unique createdAt DateTime @default(now()) entries Entry[] goals Goal[] decisions Decision[] commitments Commitment[] predictions Prediction[] evidence Evidence[] patterns Pattern[] auditEvents AuditEvent[] }
model Entry { id String @id @default(cuid()) userId String rawText String source EntrySource @default(TEXT) createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) evidence Evidence[] @@index([userId,createdAt]) }
model Goal { id String @id @default(cuid()) userId String title String description String? active Boolean @default(true) createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,active]) }
model Decision { id String @id @default(cuid()) userId String title String reasoning String? alternatives Json? expectedOutcome String? confidence Int? killCondition String? reviewAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) predictions Prediction[] }
model Prediction { id String @id @default(cuid()) userId String decisionId String? statement String probability Int? dueAt DateTime? status PredictionStatus @default(OPEN) actualOutcome String? resolvedAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) decision Decision? @relation(fields:[decisionId],references:[id],onDelete:SetNull) @@index([userId,status,dueAt]) }
model Commitment { id String @id @default(cuid()) userId String statement String dueAt DateTime? status CommitmentStatus @default(OPEN) completedAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,status,dueAt]) }
model Evidence { id String @id @default(cuid()) userId String entryId String? kind EvidenceKind claim String observedAt DateTime @default(now()) createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) entry Entry? @relation(fields:[entryId],references:[id],onDelete:SetNull) patternLinks PatternEvidence[] @@index([userId,observedAt]) }
model Pattern { id String @id @default(cuid()) userId String name String hypothesis String status PatternStatus @default(PROPOSED) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id],onDelete:Cascade) evidenceLinks PatternEvidence[] @@index([userId,status]) }
model PatternEvidence { patternId String evidenceId String polarity EvidencePolarity pattern Pattern @relation(fields:[patternId],references:[id],onDelete:Cascade) evidence Evidence @relation(fields:[evidenceId],references:[id],onDelete:Cascade) @@id([patternId,evidenceId]) }
model AuditEvent { id String @id @default(cuid()) userId String action String entityType String entityId String? metadata Json? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,createdAt]) }
